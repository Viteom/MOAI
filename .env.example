# Solo para desarrollo local. Nunca subas un .env real al repositorio.
NEO4J_PASSWORD=cambia_esto_en_local
POSTGRES_PASSWORD=cambia_esto_en_local

# Servidor de cuentas (server/). Sin estas claves, en desarrollo el código se escribe en la consola.
# DATABASE_URL=postgres://moai:cambia_esto_en_local@localhost:5432/moai   # sin ella se usa PGlite en .data/
# CODIGO_SECRETO=una_cadena_larga_y_aleatoria                            # obligatoria en producción
# Correo con Resend (https://resend.com). El remitente debe ser de un dominio verificado.
# RESEND_API_KEY=
# CORREO_REMITENTE=MOAI <hola@tu-dominio.co>
# WhatsApp con Twilio Verify (https://www.twilio.com/verify), con el canal WhatsApp activado.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
# APP_URL=https://moai.tu-dominio.co   # enlace de los recordatorios; obligatorio en producción

# Equipo de MOAI: correos (separados por coma) de quienes revisan reportes y dan de alta entidades en /equipo.
# EQUIPO_CORREOS=mateo@tu-dominio.co

# Vercel: PostgreSQL persistente obligatorio (DATABASE_URL con conexión agrupada/pooler).
# También se reconoce DATABASE_URL_DATABASE_URL, generado por el prefijo de Neon en esta beta.
# Si existen ambas, DATABASE_URL tiene prioridad. No es necesario duplicar ni revelar el secreto de Neon.
# Configura las claves solo en Settings > Environment Variables; usa una base separada para Preview.
# CODIGO_SECRETO y CRON_SECRET: secretos distintos, aleatorios y de al menos 32 caracteres.
# Conserva CODIGO_SECRETO: cambiarlo impide leer lo cifrado anteriormente.
# CRON_SECRET=                                 # Bearer de /api/interno/mantenimiento, solo en el programador
# Preparar la base antes del despliegue: npm run db:prepare (nunca durante npm run build).
# Ver docs/17-vercel-beta.md para correo, limpieza programada y comprobación de Preview.

# Gemini para interpretar UNA frase ficticia en la beta. Apagado por defecto; nunca recibe memoria ni historial.
# Revisa en Google AI Studio el modelo disponible en tu modalidad gratuita y sus cuotas/condiciones actuales.
# La API puede tener facturación si tu proyecto la tiene activada; MOAI no puede garantizar costo cero.
# GEMINI_API_KEY=                                # secreto de servidor; nunca VITE_ ni en el chat/repositorio
# GEMINI_MODEL=gemini-flash-latest                # ejemplo del SDK oficial; elige un modelo de tu proyecto
# BRISA_GEMINI_BETA=false                         # true solo para probar con texto ficticio y autorización por envío
